{
  "name": "shape-trim-paths",
  "width": 400,
  "height": 400,
  "fps": 60,
  "durationFrames": 90,
  "loop": true,
  "markers": [
    { "cm": "01-stretch", "tm": 0, "dr": 45 },
    { "cm": "02-catchup-shrink", "tm": 45, "dr": 45 }
  ],
  "layers": [
    {
      "id": "loading-spinner",
      "svg": "svg/trim-ring.svg",
      "targetId": "ring-path",
      "inFrame": 0,
      "outFrame": 90,
      "fill": false,
      "gradientStroke": {
        "type": "linear",
        "start": [80, 80],
        "end": [320, 320],
        "width": 18,
        "stops": [
          { "offset": 0, "color": "#38bdf8" },
          { "offset": 0.5, "color": "#0ea5e9" },
          { "offset": 1, "color": "#2563eb" }
        ]
      },
      "trim": {
        "startKeyframes": [
          { "frame": 0, "value": 0 },
          { "frame": 45, "value": 0 },
          { "frame": 90, "value": 75 }
        ],
        "endKeyframes": [
          { "frame": 0, "value": 15 },
          { "frame": 45, "value": 85 },
          { "frame": 90, "value": 90 }
        ],
        "offsetKeyframes": [
          { "frame": 0, "value": 0 },
          { "frame": 90, "value": 360 }
        ]
      },
      "effects": [
        {
          "type": "zoom-slide-spin",
          "start": 0,
          "end": 90,
          "rotations": 2
        }
      ]
    }
  ]
}
